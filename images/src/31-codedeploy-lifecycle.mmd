flowchart TB
  A["BeforeBlockTraffic / BlockTraffic<br/>(remove from ALB)"] --> B["ApplicationStop<br/>stop.sh"]
  B --> C["DownloadBundle<br/>(agent)"]
  C --> D["BeforeInstall<br/>before_install.sh"]
  D --> E["Install<br/>(agent copies files)"]
  E --> F["AfterInstall<br/>npm ci, daemon-reload"]
  F --> G["ApplicationStart<br/>systemctl restart myapp"]
  G --> H{"ValidateService<br/>curl /health"}
  H -->|"exit 0"| I["AllowTraffic<br/>(back into ALB)"]
  H -->|"exit 1"| R["Deployment FAILED<br/>auto rollback"]
