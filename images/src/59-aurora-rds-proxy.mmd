flowchart TB
  subgraph CLUSTER["Aurora Cluster"]
    direction TB
    WRITER[("Writer instance")] -->|"shared distributed<br/>storage (6 copies, 3 AZ)"| STORAGE[("Aurora Storage Layer")]
